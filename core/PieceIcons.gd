class_name PieceIcons
extends RefCounted
## The rank badges (assets/icons/pieces/<RANK>.svg, generated by
## tools/icons/generate_piece_badges.js). Pieces show them on their faces; UI can use the same
## textures. Textures and materials are loaded once and shared.

const PATH := "res://assets/icons/pieces/%s.svg"
const UNKNOWN := "UNKNOWN"  ## The "?" badge for a piece whose rank the viewer doesn't know.


## Badge for `rank`, falling back to the "?" badge when the rank is hidden ("").
static func badge_or_mystery(rank: String) -> Texture2D:
	return icon_texture(rank if Ranks.INFO.has(rank) else UNKNOWN)

static var _textures: Dictionary = {}
static var _materials: Dictionary = {}
static var _quad: QuadMesh


## The badge for a rank code (G5 … FLG), or null for an unknown/hidden rank.
static func icon_texture(rank: String) -> Texture2D:
	if not Ranks.INFO.has(rank) and rank != UNKNOWN:
		return null
	if not _textures.has(rank):
		_textures[rank] = load(PATH % rank)
	return _textures[rank]


## Unshaded so the art keeps its colours under any light; alpha-blended for the round edge.
static func face_material(rank: String) -> StandardMaterial3D:
	if not _materials.has(rank):
		var m := StandardMaterial3D.new()
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.albedo_texture = icon_texture(rank)
		m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
		m.render_priority = 1  # After see-through (holo) piece bodies.
		_materials[rank] = m
	return _materials[rank]


## A unit quad facing +Z, shared by every piece face.
static func quad() -> QuadMesh:
	if _quad == null:
		_quad = QuadMesh.new()
		_quad.size = Vector2.ONE
	return _quad
