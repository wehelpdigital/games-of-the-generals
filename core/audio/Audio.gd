extends Node
## Music, sound effects and ambience for the whole game (autoload "Audio"). Which file every sound
## uses, and which shop item plays which sound, is in SoundIndex (generated by
## tools/audio/build_audio.py from tools/audio/recipes.py; credits in assets/audio/CREDITS.md).
##
## It mostly listens instead of being called: button presses, screen changes (music), moves and
## trails, kill effects and taunts appearing on the board, clashes, the turn clock, powerups,
## chat, shoutouts, promotions and equipping are all picked up from signals and from effect nodes
## entering the tree, so the rest of the game needs no audio code. To play something directly:
##     Audio.play("coins")
##     Audio.play_item("kill", "kill_bazooka")
##     Audio.music("shop")

const BUS_BASE_DB := {"Music": -5.0, "SFX": 0.0, "UI": -3.0, "Ambience": -2.0}
const VOLUME_KEYS := {"Music": "vol_music", "SFX": "vol_sfx", "Ambience": "vol_ambience"}
const VOLUME_DEFAULTS := {"Music": 0.8, "SFX": 1.0, "Ambience": 0.8}
## Trails play on every move and auras only as a preview: a little quieter than the rest.
const PREFIX_DB := {"trail_": -5.0, "aura_": -3.0, "equip_": -2.0, "topper_": -2.0}
const MUSIC_FOR := {"hud": "match", "shop": "shop", "my_board": "shop", "lobby": "lobby", "rooms": "lobby", "ranked": "lobby"}
const MATCH_TRACKS := ["match_a", "match_b", "match_c"]
const WINTER_THEMES := ["christmas", "winter", "new_year"]
const FADE := 1.2
const PLAYERS := 12
const SETTINGS_FILE := "user://settings.cfg"

var _streams := {}  # path -> AudioStream
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _music: Array[AudioStreamPlayer] = []  # Two, for crossfades.
var _music_track := ""
var _music_tween: Tween
var _beds := {}  # "mine" / "theirs" / "preview" -> AudioStreamPlayer
var _bed_sounds := {"mine": "", "theirs": "", "preview": ""}
var _unlocked := false  # Browsers only allow sound after the first tap or click.
var _pending_music := ""
var _screen := ""
var _match_id := -1
var _match_count := 0
var _status := ""
var _clash_side := ""
var _clash_outcome := ""
var _clash_at := -10.0
var _kill_quiet_until := 0.0
var _last_tick := -1
var _bed_check := 0.0
var _preview_until := 0.0
var _game: Node  # Game3D, found lazily.
var _board_hooked: Node
var _ui: UIRoot
var _equip_quiet_until := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_unlocked = not OS.has_feature("web")
	_apply_saved_volumes()
	for i in PLAYERS:
		_players.append(_player("SFX"))
	for i in 2:
		_music.append(_player("Music"))
	for key: String in _bed_sounds:
		_beds[key] = _player("Ambience")
	ScreenRegistry.register("sound_test", load("res://ui/screens/SoundTestScreen.gd"))
	get_tree().node_added.connect(_on_node_added)
	GameSession.match_loaded.connect(_on_match_loaded)
	GameSession.move_result.connect(_on_move_result)
	GameSession.turn_changed.connect(_on_turn_changed)
	GameSession.game_over.connect(_on_game_over)
	GameSession.powerup_used.connect(_on_powerup_used)
	GameSession.powerup_result.connect(func(_result: Dictionary) -> void: play("powerup_good"))
	Loadout.changed.connect(_on_loadout_changed)
	Loadout.toppers_changed.connect(_on_toppers_changed)
	Social.match_message.connect(_on_match_message)
	Social.global_message.connect(_on_global_message)
	ReverbManager.event_received.connect(_on_realtime_event)
	Profile.promoted.connect(func(_tier: int) -> void: play("rank_up"))


# --- Public API -------------------------------------------------------------------------------

## A one-shot sound by name (see SoundIndex.SFX). UI sounds go to the UI bus, the rest to SFX.
func play(sound: String, volume_db := 0.0, pitch := 1.0) -> void:
	if sound == "" or not _unlocked or not SoundIndex.SFX.has(sound):
		return
	var stream := _stream(SoundIndex.SFX[sound])
	if stream == null:
		return
	var player := _players[_next]
	_next = (_next + 1) % _players.size()
	player.stop()
	player.bus = "UI" if sound.begins_with("ui_") else "SFX"
	player.stream = stream
	player.volume_db = volume_db + _prefix_db(sound)
	player.pitch_scale = pitch
	player.play()


## The sound a shop item plays (kill effects, taunts, trails, equipping...). Ambience starts its
## loop on the preview bed for a few seconds.
func play_item(category: String, slug: String, volume_db := 0.0) -> void:
	var sound := item_sound(category, slug)
	if category == "ambience":
		preview_loop(sound)
		return
	play(sound, volume_db)


## Which sound an item uses: listed in SoundIndex.ITEMS, else the first keyword in its slug or
## name, else its category's default. "" means silent (e.g. "No trail").
static func item_sound(category: String, slug: String) -> String:
	var listed: Dictionary = SoundIndex.ITEMS.get(category, {})
	if listed.has(slug):
		return listed[slug]
	if slug == "" or slug == "none":
		return ""
	var text := ("%s %s" % [slug, str(CosmeticCatalog.info(category, slug).get("name", ""))]).to_lower()
	for rule: Array in SoundIndex.KEYWORDS.get(category, []):
		if text.contains(str(rule[0])):
			return rule[1]
	return SoundIndex.DEFAULTS.get(category, "")


## Switches the music, crossfading. "match" picks the next match track; "menu" follows the season.
func music(track: String) -> void:
	if track == "match":
		track = MATCH_TRACKS[_match_count % MATCH_TRACKS.size()]
	elif track == "menu":
		track = _menu_track()
	if not SoundIndex.MUSIC.has(track) or track == _music_track:
		return
	if not _unlocked:
		_pending_music = track
		return
	_music_track = track
	var stream := _stream(SoundIndex.MUSIC[track], true)
	var outgoing := _music[0]
	var incoming := _music[1]
	_music.reverse()
	incoming.stream = stream
	incoming.volume_db = -40.0
	incoming.play()
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween().set_parallel(true)
	_music_tween.tween_property(incoming, "volume_db", 0.0, FADE)
	if outgoing.playing:
		_music_tween.tween_property(outgoing, "volume_db", -40.0, FADE)
		_music_tween.chain().tween_callback(outgoing.stop)


func music_track() -> String:
	return _music_track


## A loop on the preview bed (Sound test, shop and My Board previews), stopped after `seconds`.
func preview_loop(sound: String, seconds := 8.0) -> void:
	_set_bed("preview", sound, 0.0)
	_preview_until = Time.get_ticks_msec() / 1000.0 + seconds


func stop_preview() -> void:
	_set_bed("preview", "", 0.0)


## Linear 0..1 volume for "Music", "SFX" (also the UI bus) or "Ambience"; saved by SettingsScreen.
func set_volume(bus: String, linear: float) -> void:
	_set_bus(bus, linear)
	if bus == "SFX":
		_set_bus("UI", linear)


func volume(bus: String) -> float:
	var cfg := ConfigFile.new()
	cfg.load(SETTINGS_FILE)
	return float(cfg.get_value("ui", VOLUME_KEYS.get(bus, ""), VOLUME_DEFAULTS.get(bus, 1.0)))


# --- Listening --------------------------------------------------------------------------------

func _input(event: InputEvent) -> void:
	if _unlocked:
		return
	if (event is InputEventMouseButton or event is InputEventScreenTouch or event is InputEventKey) and event.is_pressed():
		_unlocked = true
		if _pending_music != "":
			var track := _pending_music
			_pending_music = ""
			music(track)


func _process(delta: float) -> void:
	_hook_board()
	_tick_clock()
	_bed_check -= delta
	if _bed_check <= 0.0:
		_bed_check = 0.5
		_update_beds()


func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		_hook_button(node)
	elif node is UIRoot:
		_ui = node
		_ui.screen_changed.connect(_on_screen_changed)
	elif node is KillFX or node is ClashFX:
		_on_kill_effect.call_deferred(node)
	elif node is TauntFX:
		_on_taunt.call_deferred(node)


func _hook_button(button: BaseButton) -> void:
	if button is CheckButton or button is CheckBox:
		button.toggled.connect(func(_on: bool) -> void: play("ui_toggle"))
		return
	button.pressed.connect(_on_button_pressed.bind(button))


func _on_button_pressed(button: BaseButton) -> void:
	if button.has_meta("no_click"):
		return
	var text := (button as Button).text.strip_edges().to_lower() if button is Button else ""
	if text.begins_with("buy"):
		play("ui_purchase")
	elif text.begins_with("back") or text in ["close", "cancel", "hide", "done"]:
		play("ui_back")
	elif text.begins_with("wear") or text.begins_with("equip"):
		pass  # Loadout.changed plays the item's own equip sound.
	else:
		play("ui_click")


func _on_screen_changed(screen_name: String) -> void:
	_screen = screen_name
	if screen_name == "sound_test":
		return  # The Sound test plays its own music choices.
	music(MUSIC_FOR.get(screen_name, "menu"))
	if screen_name != "hud":
		_last_tick = -1


func _on_match_loaded(view: Dictionary) -> void:
	var id := int(view.get("id", view.get("match_id", -1)))
	if id != _match_id or GameSession.kind == GameSession.Kind.PRACTICE and _status == "finished":
		_match_id = id
		_match_count += 1
		if _screen == "hud":
			_music_track = ""  # Pick the next match track.
			music("match")
	_check_status()


func _on_turn_changed() -> void:
	_last_tick = -1
	var was := _status
	_check_status()
	if was == "active" and _status == "active" and GameSession.is_my_turn():
		play("your_turn", -4.0)


func _check_status() -> void:
	var now := GameSession.status()
	if _status == "setup" and now == "active":
		play("match_start")
	_status = now


func _on_move_result(result: Dictionary) -> void:
	var board := _board()
	if board == null:
		return
	var mover: Piece3D = board.pieces.get(str(result.get("piece_id", "")))
	var side: String = mover.side if mover else str(result.get("side", ""))
	var clash: Variant = result.get("clash")
	if clash is Dictionary:
		_clash_outcome = str(clash.get("outcome", "both"))
		if side != "":
			_clash_side = Ranks.opponent(side) if _clash_outcome == "defender" else side
			_clash_at = Time.get_ticks_msec() / 1000.0
	else:
		play("piece_move", -2.0)
	if side != "":
		var trail := str(board.trails.get(side, "none"))
		play(item_sound("trail", trail), -2.0 if side == board.my_side else -6.0)


## A kill effect just appeared on a board: it belongs to the winner of the last clash, or (shop
## and My Board previews) to the player's own side.
func _on_kill_effect(node: Node) -> void:
	var board := node.get_parent()
	if not is_instance_valid(node) or not board is Board3D:
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now < _kill_quiet_until:
		return  # Some effects add a burst of their own: one sound per kill.
	var side: String = board.my_side
	if _clash_side != "" and now - _clash_at < 8.0:
		side = _clash_side
	_clash_side = ""
	var style := str(board.kill_effects.get(side, "classic"))
	if node is ClashFX and style != "classic":
		return  # A burst inside another effect, not the classic kill.
	_kill_quiet_until = now + 0.9
	var sound := item_sound("kill", style)
	play(sound)
	if sound == SoundIndex.DEFAULTS["kill"] and KillFX.is_action(style):
		# An action kill without its own sound yet: wind up now, hit at its impact time.
		play("kill_generic_windup", -4.0)
		get_tree().create_timer(float(KillFX.ACTIONS[style].get("impact", 0.4))).timeout.connect(play.bind("kill_generic"))


func _on_taunt(node: Node) -> void:
	if is_instance_valid(node) and node is TauntFX:
		play(item_sound("taunt", str(node.style)))


func _on_clash_impact(_strength: float) -> void:
	if _clash_outcome == "both":
		play("clash_tie")
	_clash_outcome = ""


func _on_game_over(info: Dictionary) -> void:
	_last_tick = -1
	_status = "finished"
	play("victory" if bool(info.get("you_won", false)) else "defeat")
	_duck_music(4.0)


func _on_powerup_used(event: Dictionary) -> void:
	if bool(event.get("mine", false)):
		play("card_slam")
	else:
		play("card_reveal")
		get_tree().create_timer(0.35).timeout.connect(play.bind("powerup_bad", -6.0))


## Equipping only makes a sound where the player is choosing (shop, My Board), and once for a
## burst of changes (Randomize, Reset, a loadout arriving from the server).
func _equip_sound_ok() -> bool:
	var now := Time.get_ticks_msec() / 1000.0
	if not _screen in ["my_board", "shop"] or now < _equip_quiet_until:
		return false
	_equip_quiet_until = now + 0.2
	return true


func _on_loadout_changed(category: String, slug: String) -> void:
	if not _equip_sound_ok():
		return
	match category:
		"kill", "taunt", "ambience":
			play("ui_equip")  # The effect's own sound plays in the demo (or the ambience loop starts).
		_:
			var sound := item_sound(category, slug)
			play(sound if sound != "" else "ui_equip")


func _on_toppers_changed() -> void:
	if not _equip_sound_ok():
		return
	var slots: Array = Loadout.get_toppers().get("slots", [])
	var last: Variant = slots.back() if not slots.is_empty() else null
	play(item_sound("topper", str(last.get("slug", ""))) if last is Dictionary else "ui_equip")


func _on_match_message(_match_id_value: int, message: Dictionary) -> void:
	if _from_someone_else(message):
		play("chat_message")


func _on_global_message(message: Dictionary) -> void:
	if _screen == "dashboard" and _from_someone_else(message):
		play("chat_message", -8.0)


func _on_realtime_event(_channel: String, event: String, _data: Dictionary) -> void:
	if event.ends_with("Shoutout"):
		play("shoutout")


func _from_someone_else(message: Dictionary) -> bool:
	var user: Variant = message.get("user")
	var id := int(user.get("id", 0)) if user is Dictionary else 0
	return id != int(ApiManager.user.get("id", -1))


## The turn clock: a tick each second through the last ten, faster ones in the last three.
func _tick_clock() -> void:
	if _screen != "hud" or GameSession.kind == GameSession.Kind.NONE or _status != "active":
		return
	if not GameSession.is_my_turn() or GameSession.clock_paused() or GameSession.turn_total() <= 0.0:
		return
	var secs := int(ceil(GameSession.time_left()))
	if secs > 10 or secs == _last_tick or secs < 0:
		return
	_last_tick = secs
	play("timeout" if secs == 0 else ("timer_urgent" if secs <= 3 else "timer_tick"), -2.0)


# --- Ambience beds ----------------------------------------------------------------------------

## My side's ambience loop (and, quieter, the opponent's) while a board with ambience is on show:
## in a match, on My Board and in shop previews.
func _update_beds() -> void:
	var mine := ""
	var theirs := ""
	var board := _board()
	if board != null and board.is_visible_in_tree():
		var own := str(board.ambiences.get(board.my_side, "none"))
		if _screen == "hud":
			mine = own
			theirs = str(board.ambiences.get(Ranks.opponent(board.my_side), "none"))
		elif _screen == "my_board" or (_screen == "shop" and _showcase_active()):
			mine = own
	var reduced := -6.0 if _ui and bool(_ui.setting("reduce_ambience", false)) else 0.0
	_set_bed("mine", item_sound("ambience", mine), reduced)
	_set_bed("theirs", "" if theirs == mine else item_sound("ambience", theirs), reduced - 9.0)
	if _bed_sounds["preview"] != "" and Time.get_ticks_msec() / 1000.0 > _preview_until:
		stop_preview()


func _set_bed(key: String, sound: String, volume_db: float) -> void:
	var player: AudioStreamPlayer = _beds[key]
	if sound == _bed_sounds[key]:
		player.volume_db = volume_db
		return
	_bed_sounds[key] = sound
	if sound == "" or not SoundIndex.LOOPS.has(sound) or not _unlocked:
		var fading := create_tween()
		fading.tween_property(player, "volume_db", -40.0, 0.6)
		fading.tween_callback(player.stop)
		if not _unlocked:
			_bed_sounds[key] = ""
		return
	player.stream = _stream(SoundIndex.LOOPS[sound], true)
	player.volume_db = -40.0
	player.play()
	create_tween().tween_property(player, "volume_db", volume_db, 1.0)


func _showcase_active() -> bool:
	var game := _game_node()
	if game == null:
		return false
	var showcase: Variant = game.get("_showcase")
	return showcase is Dictionary and not (showcase as Dictionary).is_empty()


# --- Helpers ----------------------------------------------------------------------------------

func _menu_track() -> String:
	var theme := str(ServerConfig.get_value("dashboard_theme", "classic"))
	if theme == "halloween":
		return "menu_spooky"
	if theme in WINTER_THEMES:
		return "menu_winter"
	return "menu"


func _duck_music(seconds: float) -> void:
	var player := _music[0]  # The track playing now (music() keeps it first).
	if not player.playing:
		return
	var t := create_tween()
	t.tween_property(player, "volume_db", -14.0, 0.3)
	t.tween_interval(seconds)
	t.tween_property(player, "volume_db", 0.0, 1.5)


func _game_node() -> Node:
	if _game == null or not is_instance_valid(_game):
		_game = get_tree().root.find_child("Game3D", true, false)
	return _game


func _board() -> Board3D:
	var game := _game_node()
	return game.get("board") as Board3D if game else null


func _hook_board() -> void:
	var board := _board()
	if board == null or board == _board_hooked:
		return
	_board_hooked = board
	board.clash_impact.connect(_on_clash_impact)
	board.setup_changed.connect(func() -> void: play("piece_place", -3.0))


func _stream(path: String, looping := false) -> AudioStream:
	if _streams.has(path):
		return _streams[path]
	var stream: AudioStream = load(path) if ResourceLoader.exists(path) else null
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = looping
	_streams[path] = stream
	return stream


func _player(bus: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.bus = bus
	add_child(player)
	return player


func _prefix_db(sound: String) -> float:
	for prefix: String in PREFIX_DB:
		if sound.begins_with(prefix):
			return PREFIX_DB[prefix]
	return 0.0


func _apply_saved_volumes() -> void:
	for bus: String in VOLUME_KEYS:
		set_volume(bus, volume(bus))


func _set_bus(bus: String, linear: float) -> void:
	var index := AudioServer.get_bus_index(bus)
	if index < 0:
		return
	var value := clampf(linear, 0.0, 1.0)
	AudioServer.set_bus_mute(index, value <= 0.001)
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(value, 0.001)) + float(BUS_BASE_DB.get(bus, 0.0)))
